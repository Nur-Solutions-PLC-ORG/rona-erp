# Comma-separated allowed client origins (first entry is used for auth redirects)
CLIENT_URL=

# Public API origin used for the Google OAuth redirect URI (defaults to http://localhost:8000)
API_URL=

DATABASE_URL=

RESEND_API_KEY=
RESEND_EMAIL_FROM=

# SMTP (nodemailer) — used to send auth codes and account one-time passwords
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

JWT_SECRET=

# WebAuthn (kiosk employee passkey login)
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=
WEBAUTHN_ORIGIN=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI assistant (Gemini)
GOOGLE_API_KEY=
AI_GEMINI_MODEL=
AI_GEMINI_TEMPERATURE=
AI_GEMINI_MAX_OUTPUT_TOKENS=
AI_GEMINI_THINKING_BUDGET=
AI_GEMINI_TIMEOUT_SECONDS=
AI_GEMINI_MAX_ATTEMPTS=

# AI report worker: embedded | external
AI_REPORT_WORKER_MODE=
AI_REPORT_OUTPUT_DIR=

# ONLY IN PRODUCTION
PORT=