@baseUrl = http://localhost:8502
@csrf_token = 

get a csrf token first
GET {{baseUrl}}/auth/csrf

###
POST {{baseUrl}}/auth/register
Content-Type: application/json
X-CSRF-Token: {{csrf_token}}

{
  "email": "test@example.com",
  "password": "SecurePass1!",
  "name": "Test User",
  "orgName": "Test Org"
}

###
POST {{baseUrl}}/auth/signin
Content-Type: application/json
X-CSRF-Token: {{csrf_token}}

{
  "email": "test@example.com",
  "password": "SecurePass1!"
}

###
POST {{baseUrl}}/auth/signin
Content-Type: application/json
X-CSRF-Token: {{csrf_token}}

{
  "eid": "EMP123",
  "tenant_id": "YOUR-TENANT-UUID-HERE",
  "password": "password123"
}

###
POST {{baseUrl}}/auth/signin/mfa
Content-Type: application/json
X-CSRF-Token: {{csrf_token}}

{
  "email": "test@example.com",
  "code": "123456"
}

###
GET {{baseUrl}}/auth/mfa/setup
Authorization: Bearer YOUR_ACCESS_TOKEN

turn on mfa with a code from your phone
POST {{baseUrl}}/auth/mfa/enable
Content-Type: application/json
Authorization: Bearer YOUR_ACCESS_TOKEN

{
  "code": "123456"
}

###
POST {{baseUrl}}/auth/mfa/disable
Content-Type: application/json
Authorization: Bearer YOUR_ACCESS_TOKEN

{
  "code": "123456"
}

###
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json
X-CSRF-Token: {{csrf_token}}

{
  "email": "test@example.com"
}

###
POST {{baseUrl}}/auth/reset-password
Content-Type: application/json
X-CSRF-Token: {{csrf_token}}

{
  "email": "test@example.com",
  "code": "123456",
  "newPassword": "NewSecurePass1!"
}

###get a fresh access token
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "YOUR_REFRESH_TOKEN"
}

###
POST {{baseUrl}}/auth/send-verification
Content-Type: application/json
X-CSRF-Token: {{csrf_token}}

{
  "email": "test@example.com"
}

###
POST {{baseUrl}}/auth/verify-code
Content-Type: application/json
X-CSRF-Token: {{csrf_token}}

{
  "email": "test@example.com",
  "code": "123456"
}

###
GET {{baseUrl}}/auth/status

###get your profile info
GET {{baseUrl}}/auth/user

###log out
POST {{baseUrl}}/auth/signout

###start google login
GET {{baseUrl}}/auth/google/url

###google calls you back here
GET {{baseUrl}}/auth/google/callback
