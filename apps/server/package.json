{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:push": "drizzle-kit generate && drizzle-kit push",
    "db:reset": "ts-node -r tsconfig-paths/register --project tsconfig.json src/scripts/reset-database.ts",
    "db:seed:platform-configs": "ts-node -r tsconfig-paths/register --project tsconfig.json src/scripts/populate-platform-configs.ts",
    "db:seed:rbac": "ts-node -r tsconfig-paths/register --project tsconfig.json src/scripts/seed-rbac.ts",
    "db:seed:admin": "ts-node -r tsconfig-paths/register --project tsconfig.json src/scripts/seed-admin.ts",
    "db:seed:inventory": "ts-node -r tsconfig-paths/register --project tsconfig.json src/scripts/seed-inventory.ts",
    "db:seed:manufacturing": "ts-node -r tsconfig-paths/register --project tsconfig.json src/scripts/seed-manufacturing.ts",
    "db:seed:quality": "ts-node -r tsconfig-paths/register --project tsconfig.json src/scripts/seed-quality.ts",
    "db:seed:hr": "ts-node -r tsconfig-paths/register --project tsconfig.json src/scripts/seed-hr.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@rona/config": "workspace:*",
    "@rona/routes": "workspace:*",
    "@rona/types": "workspace:*",
    "@rona/validation": "workspace:*",
    "@upstash/redis": "^1.38.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "google-auth-library": "^10.9.1",
    "jsonwebtoken": "^9.0.3",
    "nestjs-pino": "^5.1.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.18.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "moduleResolution": "node10",
            "target": "ES2023",
            "esModuleInterop": true,
            "allowSyntheticDefaultImports": true,
            "experimentalDecorators": true,
            "emitDecoratorMetadata": true,
            "isolatedModules": true,
            "strict": true,
            "skipLibCheck": true,
            "types": [
              "node",
              "jest"
            ]
          }
        }
      ]
    },
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@rona/config$": "<rootDir>/../../../packages/config/src/global/index.ts",
      "^@rona/config/(.*)$": "<rootDir>/../../../packages/config/src/$1/index.ts",
      "^@rona/validation/(.*)$": "<rootDir>/../../../packages/validation/src/$1/index.ts",
      "^@rona/types/(.*)$": "<rootDir>/../../../packages/types/src/$1/index.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
